# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno para EGS Panel
#
# INSTRUCCIONES:
#   1. Copia este archivo como  .env  en la raíz del proyecto.
#   2. Rellena los valores reales de producción.
#   3. Sube .env al servidor por FTP (NUNCA lo subas al repositorio git).
#   4. El archivo .env está en .gitignore — no aparecerá en commits.
# ─────────────────────────────────────────────────────────────────────────────


# ── Entorno ───────────────────────────────────────────────────────────────────
# "production" | "development"
APP_ENV=production

# Nombre del proyecto (usado en títulos y reportes)
APP_NAME="EGS Equipo de Cómputo"


# ── Base de datos del sistema de ventas (mysqli — config/Conexion.php) ────────
DB_SISTEMA_HOST=localhost
DB_SISTEMA_NAME=USUARIO_sistema
DB_SISTEMA_USER=USUARIO_sistema
DB_SISTEMA_PASS=


# ── Base de datos de e-commerce / productos (PDO — modelos/conexion.php) ──────
DB_ECOMMERCE_HOST=localhost
DB_ECOMMERCE_NAME=USUARIO_ecommerce
DB_ECOMMERCE_USER=USUARIO_app
DB_ECOMMERCE_PASS=


# ── Base de datos principal: órdenes, pedidos, comisiones ─────────────────────
# (PDO — modelos/conexionWordpress.php)
DB_WORDPRESS_HOST=localhost
DB_WORDPRESS_NAME=USUARIO_ordenes
DB_WORDPRESS_USER=USUARIO_app
DB_WORDPRESS_PASS=


# ── Correo (PHPMailer) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@egsequipodecomputo.com
MAIL_PASSWORD=
MAIL_FROM_NAME="EGS Equipo de Cómputo"
MAIL_ENCRYPTION=tls


# ── Integración opcional con servicio Node.js para WhatsApp ────────────────
# Endpoint que recibirá notificaciones de cambio de estado en órdenes.
# Ejemplo: https://tu-dominio.com/whatsapp/orden-status
NODE_WHATSAPP_ENDPOINT=

# Token Bearer opcional para autenticar contra tu servicio Node.js.
NODE_WHATSAPP_TOKEN=

# Timeout (segundos) para la llamada HTTP al servicio Node.js.
NODE_WHATSAPP_TIMEOUT=5

# ── Hosting y migración ─────────────────────────────────────────────────────
# production activa escrituras externas; staging las bloquea.
EGS_HOSTING_MODE=staging
EGS_BACKEND_URL=https://backend.comercializadoraegs.com
EGS_WORDPRESS_URL=https://comercializadoraegs.com
EGS_WORDPRESS_ROOT=/home/USUARIO/public_html
EGS_DRIVE_STATE_DIR=/home/USUARIO/.egs-drive
EGS_BACKUP_STATE_DIR=/home/USUARIO/.egs-backup
EGS_BACKUP_TIMEZONE=America/Mexico_City
EGS_BACKUP_HOUR=3
EGS_BACKUP_WEEKDAY=7
# JSON esquema→conexión (ecommerce, wordpress o una clave de CONNECTIONS).
# EGS_BACKUP_DATABASES={"mi_ecommerce":"ecommerce","mis_ordenes":"wordpress","mi_wordpress":"site"}
# CONNECTIONS: conexiones adicionales con host, port, dbname, user, pass.
# EGS_BACKUP_CONNECTIONS={"site":{"host":"localhost","port":3306,"dbname":"mi_wordpress","user":"usuario","pass":"secreto"}}
DB_SISTEMA_PORT=3306
DB_ECOMMERCE_PORT=3306
DB_WORDPRESS_PORT=3306
MAIL_FROM_ADDRESS=noreply@comercializadoraegs.com
MAIL_REPLY_TO=contacto@comercializadoraegs.com
# Sólo si las herramientas no están en PATH:
# EGS_BIN_PHP=/ruta/php
# EGS_BIN_MYSQLDUMP=/ruta/mysqldump
# EGS_BIN_GPG=/ruta/gpg
# EGS_BIN_TAR=/ruta/tar
# EGS_BIN_GZIP=/ruta/gzip
